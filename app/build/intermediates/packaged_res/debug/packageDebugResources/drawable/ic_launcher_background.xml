<?xml version="1.0" encoding="utf-8"?>
<!-- Brushed dark metal plate behind the lens, so the icon reads as a physical object. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF3A3F45" />
                <item android:offset="0.35" android:color="#FF242830" />
                <item android:offset="0.72" android:color="#FF171A1F" />
                <item android:offset="1.0" android:color="#FF0C0E11" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vignette so the plate edges fall away from the lens. -->
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40"
                android:centerY="36"
                android:gradientRadius="86">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="0.55" android:color="#00000000" />
                <item android:offset="1.0" android:color="#66000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
