<?xml version="1.0" encoding="utf-8"?>
<!--
  Skeuomorphic camera lens, kept deliberately simple: brushed metal bezel,
  grip rings, dark coated glass, specular sweep and a mechanical iris.
  Depth comes from gradients rather than many detail layers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Contact shadow under the barrel. -->
    <path
        android:fillColor="#05070A"
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z" />

    <!-- Chrome bezel: brushed metal lit from the top-left. -->
    <path android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="20"
                android:endX="92"
                android:endY="94">
                <item android:offset="0.0" android:color="#FFF4F7FA" />
                <item android:offset="0.24" android:color="#FFB6BFC8" />
                <item android:offset="0.52" android:color="#FF6E777F" />
                <item android:offset="0.8" android:color="#FF343B42" />
                <item android:offset="1.0" android:color="#FF1B2026" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Barrel body. -->
    <path android:pathData="M26.5,54 a27.5,27.5 0 1,0 55,0 a27.5,27.5 0 1,0 -55,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="28"
                android:endX="86"
                android:endY="88">
                <item android:offset="0.0" android:color="#FF4C535A" />
                <item android:offset="0.45" android:color="#FF2A2F35" />
                <item android:offset="1.0" android:color="#FF101317" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Focus grip: two bands read as a knurled ring. -->
    <path
        android:strokeColor="#5A626A"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M28.5,54 a25.5,25.5 0 1,0 51,0 a25.5,25.5 0 1,0 -51,0 Z" />
    <path
        android:strokeColor="#0B0D10"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M30.5,54 a23.5,23.5 0 1,0 47,0 a23.5,23.5 0 1,0 -47,0 Z" />

    <!-- Focus index mark. -->
    <path
        android:fillColor="#FFE0AE33"
        android:pathData="M53,27.5 h2 v4.5 h-2 Z" />

    <!-- Inner bezel recess. -->
    <path android:pathData="M33,54 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="34"
                android:endX="78"
                android:endY="76">
                <item android:offset="0.0" android:color="#FF2C3238" />
                <item android:offset="0.55" android:color="#FF12161A" />
                <item android:offset="1.0" android:color="#FF05070A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coated glass. -->
    <path android:pathData="M35,54 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44"
                android:centerY="43"
                android:gradientRadius="34">
                <item android:offset="0.0" android:color="#FF35637A" />
                <item android:offset="0.45" android:color="#FF14303D" />
                <item android:offset="0.8" android:color="#FF08161E" />
                <item android:offset="1.0" android:color="#FF030609" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Iris: hexagonal diaphragm with the pupil inside. -->
    <path
        android:strokeColor="#7D868E"
        android:strokeWidth="1.3"
        android:fillColor="#05080B"
        android:pathData="M54,45.5 L49.63,48.25 L49.63,53.75 L54,56.5 L58.37,53.75 L58.37,48.25 Z" />
    <path
        android:fillColor="#010203"
        android:pathData="M54,48 L51.5,49.5 L51.5,52.5 L54,54 L56.5,52.5 L56.5,49.5 Z" />

    <!-- Specular sweep on the upper-left glass. -->
    <path
        android:strokeColor="#7AF4F8FA"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40.5,49 a15,15 0 0,1 12,-8.5" />
</vector>
