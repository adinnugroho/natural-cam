<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal skeuomorphic 3D lens: raised chrome bezel, recessed barrel, domed coated glass,
     chrome aperture ring and one specular glint. Every depth cue is a gradient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cast shadow. -->
    <path
        android:pathData="M24.5,57.5 a30,29 0 1,0 60,0 a30,29 0 1,0 -60,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial" android:centerX="54.5" android:centerY="57.5" android:gradientRadius="30">
                <item android:offset="0.0" android:color="#40000000" />
                <item android:offset="0.6" android:color="#33000000" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Raised chrome bezel. -->
    <path
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear" android:startX="30" android:startY="24" android:endX="78" android:endY="84">
                <item android:offset="0.0" android:color="#FFF7FAFB" />
                <item android:offset="0.14" android:color="#FFCFD5DA" />
                <item android:offset="0.4" android:color="#FF929AA1" />
                <item android:offset="0.66" android:color="#FF565D64" />
                <item android:offset="0.88" android:color="#FF30363C" />
                <item android:offset="1.0" android:color="#FF1E2328" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M26.1234,46.0065 A29,29 0 0 1 66.7128,27.935"
        android:fillColor="#00000000" />

    <!-- Recessed barrel. -->
    <path
        android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear" android:startX="32" android:startY="34" android:endX="76" android:endY="76">
                <item android:offset="0.0" android:color="#FF434A51" />
                <item android:offset="0.45" android:color="#FF20252B" />
                <item android:offset="1.0" android:color="#FF0A0C10" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:strokeColor="#7A000000"
        android:strokeWidth="1.5"
        android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0 Z"
        android:fillColor="#00000000" />

    <!-- Domed coated glass. -->
    <path
        android:pathData="M34,54 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial" android:centerX="47.5" android:centerY="46.5" android:gradientRadius="26">
                <item android:offset="0.0" android:color="#FF8CC2CD" />
                <item android:offset="0.24" android:color="#FF37697A" />
                <item android:offset="0.5" android:color="#FF16414E" />
                <item android:offset="0.76" android:color="#FF08202A" />
                <item android:offset="1.0" android:color="#FF030A0E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Chrome aperture ring. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M41.4,54 a12.6,12.6 0 1,0 25.2,0 a12.6,12.6 0 1,0 -25.2,0 Z M43.6,54 a10.4,10.4 0 1,0 20.8,0 a10.4,10.4 0 1,0 -20.8,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear" android:startX="44" android:startY="44" android:endX="64" android:endY="64">
                <item android:offset="0.0" android:color="#FFE8EDEF" />
                <item android:offset="0.35" android:color="#FF9BA3AA" />
                <item android:offset="0.7" android:color="#FF4B5259" />
                <item android:offset="1.0" android:color="#FF242A30" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pupil. -->
    <path
        android:pathData="M47,54 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial" android:centerX="52.5" android:centerY="52.5" android:gradientRadius="10">
                <item android:offset="0.0" android:color="#FF0A1118" />
                <item android:offset="0.55" android:color="#FF03070B" />
                <item android:offset="1.0" android:color="#FF000203" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular glint. -->
    <path
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M40.01,45.26 A16.5,16.5 0 0 1 54.58,37.51"
        android:fillColor="#00000000" />
</vector>
